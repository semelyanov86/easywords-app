meta {
  name: Get Basic Statistics
  type: http
  seq: 1
}

get {
  url: {{BASE_URL}}/statistics
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
}

docs {
  Возвращает базовую статистику по словам текущего авторизованного пользователя.

  **Пример ответа (200 OK):**

  ```json
  {
    "data": {
      "type": "statistics",
      "attributes": {
        "total_words": 150,
        "starred_words": 25,
        "not_done_words": 120,
        "done_words": 30,
        "total_views": 1250,
        "total_users": 500,
        "top_viewed_words": [
          {
            "type": "words",
            "id": "1",
            "attributes": {
              "original": "das Haus",
              "translated": "дом",
              "language": "DE",
              "done_at": "2026-01-10T15:30:00.000000Z",
              "starred": true,
              "views": 50,
              "from_sample": false,
              "created_at": "2026-01-05T10:00:00.000000Z",
              "updated_at": "2026-01-10T15:30:00.000000Z"
            }
          }
        ],
        "words_added_today": [
          {
            "type": "words",
            "id": "150",
            "attributes": {
              "original": "neues Wort",
              "translated": "новое слово",
              "language": "DE",
              "done_at": null,
              "starred": false,
              "views": 0,
              "from_sample": false,
              "created_at": "2026-01-11T20:00:00.000000Z",
              "updated_at": "2026-01-11T20:00:00.000000Z"
            }
          }
        ],
        "words_updated_today": 5,
        "words_updated_this_month": 45
      }
    }
  }
  ```
}
