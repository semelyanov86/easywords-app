meta {
  name: Translate Word
  type: http
  seq: 1
}

get {
  url: {{BASE_URL}}/translate?word=riskant&language=DE
  body: none
  auth: bearer
}

params:query {
  word: riskant
  language: DE
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{TOKEN}}
}

settings {
  encodeUrl: true
  timeout: 0
}
