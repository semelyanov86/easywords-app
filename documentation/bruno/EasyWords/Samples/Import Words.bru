meta {
  name: Import Words
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/samples/import/DE
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Импортирует примеры слов для указанного языка из базы samples.

  **Параметры URL:**
  - `{LANGUAGE}`: Код языка для импорта (например, DE, EN, FR)

  **Пример ответа (201 Created):**

  ```json
  {
    "data": {
      "type": "import-samples",
      "id": "0",
      "attributes": {
        "total_created": 10,
        "total_skipped": 2
      },
      "relationships": {
        "words": {
          "data": [
            {
              "type": "words",
              "id": "1",
              "attributes": {
                "original": "das Haus",
                "translated": "дом",
                "language": "DE",
                "done_at": null,
                "starred": false,
                "views": 0,
                "from_sample": true,
                "created_at": "2026-01-11T20:00:00.000000Z",
                "updated_at": "2026-01-11T20:00:00.000000Z"
              }
            }
          ]
        }
      }
    },
    "included": [
      {
        "type": "words",
        "id": "1",
        "attributes": {
          "original": "das Haus",
          "translated": "дом",
          "language": "DE",
          "done_at": null,
          "starred": false,
          "views": 0,
          "from_sample": true,
          "created_at": "2026-01-11T20:00:00.000000Z",
          "updated_at": "2026-01-11T20:00:00.000000Z"
        }
      }
    ]
  }
  ```
}
