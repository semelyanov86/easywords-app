meta {
  name: Update Password
  type: http
  seq: 3
}

put {
  url: {{BASE_URL}}/user/password
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{TOKEN}}
}

body:json {
  {
    "current_password": "password123",
    "password": "password",
    "password_confirmation": "password"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
