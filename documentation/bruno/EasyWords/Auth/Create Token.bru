meta {
  name: Create Token
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/token
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "se@sergeyem.ru",
    "password": "password"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Creates an access token to access application
}
