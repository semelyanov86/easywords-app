meta {
  name: Star Word
  type: http
  seq: 4
}

put {
  url: {{BASE_URL}}/words/1014/starred
  body: json
  auth: inherit
}

body:json {
  {
    "starred": true
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Устанавливает или снимает отметку "избранное" для слова.

  **Параметры URL:**
  - `{WORD_ID}`: ID слова для изменения статуса избранного

  **Требуемые параметры:**
  - `starred`: true - добавить в избранное, false - убрать из избранного

  **Пример ответа (200 OK):**

  ```json
  {
    "data": {
      "type": "words",
      "id": "1014",
      "attributes": {
        "original": "das Buch",
        "translated": "книга",
        "language": "DE",
        "done_at": null,
        "starred": true,
        "views": 51,
        "from_sample": false,
        "created_at": "2026-01-05T10:00:00.000000Z",
        "updated_at": "2026-01-11T20:00:00.000000Z"
      }
    }
  }
  ```
}
