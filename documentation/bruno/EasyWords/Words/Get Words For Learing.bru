meta {
  name: Get Words For Learing
  type: http
  seq: 8
}

get {
  url: {{BASE_URL}}/words?language=DE
  body: none
  auth: inherit
}

params:query {
  language: DE
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Возвращает пагинированный список слов текущего пользователя с фильтрацией по языку.

  **Query параметры:**
  - `language`: Код языка для фильтрации (например, DE, EN, FR)

  **Пример ответа (200 OK):**

  ```json
  {
    "data": [
      {
        "type": "words",
        "id": "1",
        "attributes": {
          "original": "das Haus",
          "translated": "дом",
          "language": "DE",
          "done_at": null,
          "starred": false,
          "views": 5,
          "from_sample": true,
          "created_at": "2026-01-05T10:00:00.000000Z",
          "updated_at": "2026-01-05T10:00:00.000000Z"
        }
      },
      {
        "type": "words",
        "id": "2",
        "attributes": {
          "original": "die Katze",
          "translated": "кошка",
          "language": "DE",
          "done_at": "2026-01-10T15:30:00.000000Z",
          "starred": true,
          "views": 50,
          "from_sample": false,
          "created_at": "2026-01-05T10:00:00.000000Z",
          "updated_at": "2026-01-10T15:30:00.000000Z"
        }
      }
    ],
    "links": {
      "first": "http://localhost/api/words?language=DE&page=1",
      "last": "http://localhost/api/words?language=DE&page=5",
      "prev": null,
      "next": "http://localhost/api/words?language=DE&page=2"
    },
    "meta": {
      "current_page": 1,
      "from": 1,
      "last_page": 5,
      "links": [
        {
          "url": null,
          "label": "&laquo; Previous",
          "active": false
        },
        {
          "url": "http://localhost/api/words?language=DE&page=1",
          "label": "1",
          "active": true
        },
        {
          "url": "http://localhost/api/words?language=DE&page=2",
          "label": "2",
          "active": false
        }
      ],
      "path": "http://localhost/api/words",
      "per_page": 15,
      "to": 15,
      "total": 75
    }
  }
  ```
}
