meta {
  name: Create New Word
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/words
  body: json
  auth: inherit
}

body:json {
  {
    "original": "Smooozy",
    "translated": "Смузи",
    "language": "DE"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Создаёт новое слово для текущего авторизованного пользователя.

  **Требуемые параметры:**
  - `original`: Слово на оригинальном языке
  - `translated`: Перевод слова
  - `language`: Код языка (например, DE, EN, FR)

  **Пример ответа (201 Created):**

  ```json
  {
    "data": {
      "type": "words",
      "id": "151",
      "attributes": {
        "original": "Smooozy",
        "translated": "Смузи",
        "language": "DE",
        "done_at": null,
        "starred": false,
        "views": 0,
        "from_sample": false,
        "created_at": "2026-01-11T20:00:00.000000Z",
        "updated_at": "2026-01-11T20:00:00.000000Z"
      }
    }
  }
  ```
}
