meta {
  name: Profile Info
  type: http
  seq: 1
}

get {
  url: {{BASE_URL}}/me
  body: none
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{TOKEN}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Возвращает информацию о текущем авторизованном пользователе.

  **Требуется авторизация:** Bearer токен в заголовке Authorization

  **Пример ответа (200 OK):**

  ```json
  {
    "data": {
      "type": "users",
      "id": "1",
      "attributes": {
        "name": "John Doe",
        "email": "john@example.com",
        "is_admin": false,
        "has_premium": true,
        "created_at": "2026-01-05T10:00:00.000000Z",
        "updated_at": "2026-01-11T20:00:00.000000Z"
      }
    }
  }
  ```
}
